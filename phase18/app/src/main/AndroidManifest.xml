<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MilkShopApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true">
        <provider
            android:name=".statements.StatementFileProvider"
            android:authorities="${applicationId}.statements"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/statement_paths" />
        </provider>
        <!-- 14.8.6 cutover: the native app is the product. HybridActivity is
             retained dormant until its removal phase. -->
        <activity-alias
            android:name=".Main"
            android:exported="true"
            android:targetActivity=".nativeui.NativePreviewActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".nativeui.NativePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.SaafMilk.Native"
            android:windowSoftInputMode="adjustResize" />
        <!-- Native Compose receives animated IME insets under edge-to-edge.
             The shared scaffold consumes its padding before IME padding;
             access forms own their insets outside the signed-in scaffold. -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".hybrid.HybridActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:theme="@style/Theme.SaafMilk.Hybrid"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
