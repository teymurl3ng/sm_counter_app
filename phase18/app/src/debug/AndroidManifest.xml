<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity android:name="androidx.activity.ComponentActivity"
            android:theme="@style/Theme.SaafMilk.Native" tools:replace="android:theme" />
        <receiver
            android:name=".sync.SyncDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.saaf.milkshop.sync.ENROLL" />
                <action android:name="com.saaf.milkshop.sync.STATUS" />
                <action android:name="com.saaf.milkshop.sync.DRAIN" />
                <action android:name="com.saaf.milkshop.sync.UNENROLL" />
                <action android:name="com.saaf.milkshop.sync.SNAPSHOT" />
                <action android:name="com.saaf.milkshop.sync.RESTORE_LATEST" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
