<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode launch: the window background paints before the first Compose
         frame, so match the dark theme's background instead of flashing ivory.
         The explicit parent matters: without it the dot notation implicitly
         requires a base Theme.SaafMilk style, which does not exist. -->
    <style name="Theme.SaafMilk.Native" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#101713</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
