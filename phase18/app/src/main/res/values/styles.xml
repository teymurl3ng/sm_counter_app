<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SaafMilk.Native" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F4F1E8</item>
        <item name="android:colorAccent">#173F32</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.SaafMilk.Hybrid" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F7F6F0</item>
        <item name="android:colorAccent">#047857</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Phase 11A: a small, reusable View-system layer inspired by Material 3's role-based design. -->
    <style name="MilkShop.Text.Display" parent="@android:style/TextAppearance.Material.Headline">
        <item name="android:textSize">@dimen/milk_shop_text_display</item>
        <item name="android:textColor">@color/milk_shop_color_on_background</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MilkShop.Text.Headline" parent="@android:style/TextAppearance.Material.Headline">
        <item name="android:textSize">@dimen/milk_shop_text_headline</item>
        <item name="android:textColor">@color/milk_shop_color_on_background</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MilkShop.Text.Title" parent="@android:style/TextAppearance.Material.Title">
        <item name="android:textSize">@dimen/milk_shop_text_title</item>
        <item name="android:textColor">@color/milk_shop_color_on_background</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MilkShop.Text.Body" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">@dimen/milk_shop_text_body</item>
        <item name="android:textColor">@color/milk_shop_color_on_surface</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="MilkShop.Text.BodyMuted" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">@dimen/milk_shop_text_body_small</item>
        <item name="android:textColor">@color/milk_shop_color_on_surface_variant</item>
    </style>

    <style name="MilkShop.Text.Label" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">@dimen/milk_shop_text_label</item>
        <item name="android:textColor">@color/milk_shop_color_on_surface_variant</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MilkShop.Text.Caption" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textSize">@dimen/milk_shop_text_caption</item>
        <item name="android:textColor">@color/milk_shop_color_on_surface_variant</item>
    </style>

    <!-- These control tokens are applied as screens migrate; they do not alter existing controls yet. -->
    <style name="MilkShop.Control.Button.Primary" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">@dimen/milk_shop_button_min_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/milk_shop_button_text</item>
        <item name="android:backgroundTint">@color/milk_shop_color_primary</item>
    </style>

    <style name="MilkShop.Control.Button.Secondary" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">@dimen/milk_shop_button_min_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/milk_shop_secondary_button_text</item>
        <item name="android:backgroundTint">@color/milk_shop_color_primary_container</item>
    </style>

    <style name="MilkShop.Control.Input" parent="@android:style/Widget.Material.EditText">
        <item name="android:minHeight">@dimen/milk_shop_control_min_height</item>
        <item name="android:textSize">@dimen/milk_shop_text_body</item>
        <item name="android:textColor">@color/milk_shop_color_on_surface</item>
    </style>
</resources>
