# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.apk
output.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Python verification cache
__pycache__/
*.pyc

# Sync release signing (never commit)
keystore.properties
phase18/keystore/
phase18/oauth.properties

# Local agent workspace + one-off leftovers (never commit)
.zcode/
.zcodeignore
before_state.png
phase18/edit_h8e.py
counter_access.txt
counter_token.json

# Local audit runtimes, external checkouts, and private preview recovery data
audit/**/checkout/
audit/**/runtime/
audit/**/node_modules/
audit/**/.next/
audit/**/preview-owner-account/
audit/**/*.db*
audit/**/*.sqlite*
audit/**/.env*

# Large generated QA artifacts stay local; review manifests are retained
audit/**/*.mp4
phase14-evidence/**/*.mp4
audit/**/*.perfetto-trace
audit/**/logcat-*.txt
audit/**/*.pb
audit/**/*.textproto

# Isolated finish/publication candidates and generated release outputs
audit/2026-10-14/finish-engineering/server-checkout/
audit/2026-10-14/finish-engineering/viewer-checkout/
audit/2026-10-14/finish-engineering/release/
