<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MilkShopApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="Saaf Milk"
        android:supportsRtl="true">
        <activity
            android:name=".nativeui.NativePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.SaafMilk.Native" />
        <!-- No windowSoftInputMode here: the activity runs edge-to-edge
             (enableEdgeToEdge → decorFitsSystemWindows=false) and every form
             applies imePadding() once. adjustResize on top of that applied the
             keyboard height twice, painting a background-colored band above
             the keyboard. HybridActivity keeps adjustResize: its WebView
             publishes IME insets to CSS separately. -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".hybrid.HybridActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:theme="@style/Theme.SaafMilk.Hybrid"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
