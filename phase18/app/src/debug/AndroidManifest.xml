<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".nativeui.NativePreviewActivity"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".hybrid.HybridActivity"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".sync.SyncDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.saaf.milkshop.sync.ENROLL" />
                <action android:name="com.saaf.milkshop.sync.STATUS" />
                <action android:name="com.saaf.milkshop.sync.UNENROLL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
